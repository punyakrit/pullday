# Copy to .env. These defaults match docker-compose.yml and work as they are.
DATABASE_URL=postgres://pullday:pullday@127.0.0.1:54329/pullday
PORT=4000
# 1 turns on /dev/* (grant cards, move time, reset). Test accounts only.
DEV_TOOLS=1
# Stripe test keys, for win back. Empty: payments are not set up and everything else works.
# A key that is not a test key stops the server. See README.md for where to get them.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
