{
  "name": "pullday-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "migrate": "tsx src/cli/migrate.ts",
    "seed": "tsx src/cli/seed.ts",
    "reset": "tsx src/cli/reset.ts",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "play-day": "tsx src/cli/playDay.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "temporal-polyfill": "^1.0.8",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
